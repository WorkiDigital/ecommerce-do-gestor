// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// NextAuth Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("GESTOR") // GESTOR, ADMIN
  status        String    @default("ACTIVE") // ACTIVE, BANNED
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Business Models
model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  slug          String   @unique
  displayName   String
  avatarUrl     String?
  bio           String   @db.Text
  city          String
  state         String
  whatsapp      String
  instagram     String?
  facebook      String?
  website       String?
  
  niches        String[]
  platforms     String[]
  minPrice      Float    @default(0)
  tagline       String?  @db.Text
  
  plan          String   @default("free") // free, pro, agency
  isVerified    Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  badge         String?
  
  avgRating     Float    @default(0)
  reviewCount   Int      @default(0)
  
  views         Int      @default(0)
  whatsappClicks Int     @default(0)
  
  reviews       Review[]
  leads         Lead[]
  portfolio     PortfolioItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Review {
  id              String   @id @default(cuid())
  profileId       String
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  reviewerName    String
  reviewerCompany String?
  rating          Int
  comment         String   @db.Text
  response        String?  @db.Text
  respondedAt     DateTime?
  
  createdAt       DateTime @default(now())
}

model Lead {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  name        String
  email       String
  phone       String
  instagram   String?
  revenue     String
  status      String    @default("NEW") // NEW, CONTACTED, CLOSED, LOST
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PortfolioItem {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  title       String
  description String   @db.Text
  imageUrl    String
  metrics     Json?    // Stores detailed metrics as JSON
  
  createdAt   DateTime @default(now())
}

// --- Analytics & Ads Management Models ---

enum PlatformType {
  META_ADS
  GOOGLE_ADS
  TIKTOK_ADS
  ORGANIC
}

enum LeadStatus {
  NOVO_LEAD
  EM_ATENDIMENTO
  QUALIFICADO
  PROPOSTA_ENVIADA
  VENDA_CONCLUIDA
  PERDIDO_DESQUALIFICADO
}

enum MediaType {
  IMAGE
  VIDEO
  CAROUSEL
}

model AdAccount {
  id          String   @id @default(cuid())
  name        String
  clientName  String
  platform    PlatformType
  externalId  String?  // ID da conta de anúncios
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  campaigns   Campaign[]
  leads       AdLead[]
  savedViews  SavedView[]
}

model Campaign {
  id          String   @id @default(cuid())
  accountId   String
  account     AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId  String   // ID na Meta/Google
  name        String
  status      String   // ACTIVE, PAUSED, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  adSets      AdSet[]
  
  @@index([accountId, externalId])
}

model AdSet {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  externalId  String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  ads         Ad[]
  
  @@index([campaignId, externalId])
}

model Ad {
  id            String    @id @default(cuid())
  adSetId       String
  adSet         AdSet     @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  externalId    String
  name          String
  mediaType     MediaType?
  creativeUrl   String?
  thumbnailUrl  String?
  hookCategory  String?   // Ex: "Dor", "Benefício", "Prova Social"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  leads         AdLead[]
  
  @@index([adSetId, externalId])
}

model AdLead {
  id              String      @id @default(cuid())
  accountId       String
  account         AdAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  adId            String?
  ad              Ad?         @relation(fields: [adId], references: [id], onDelete: SetNull)
  
  // Dados do Contato
  name            String?
  phone           String
  city            String?
  state           String?
  country         String?     @default("BR")
  
  // Parâmetros de Rastreamento (UTMs e IDs)
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  sourceId        String?     // Identificador único da fonte
  pageId          String?     // ID da página/perfil
  ctwAciId        String?     // Click-to-WhatsApp Ad Click ID
  pixelId         String?
  eventSourceUrl  String?
  instanceName    String?     // Instância WhatsApp (ex: Evolution API)
  
  // Status do Funil Comercial
  status          LeadStatus  @default(NOVO_LEAD)
  saleValue       Decimal?    @db.Decimal(10, 2)
  saleDate        DateTime?
  
  // Metadados
  firstMessage    String?     @db.Text
  capiSynced      Boolean     @default(false)
  capiSyncedAt    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  @@index([accountId, status, createdAt])
  @@index([utmCampaign, utmContent])
  @@index([ctwAciId])
  @@index([phone])
}

model SavedView {
  id          String   @id @default(cuid())
  accountId   String?
  account     AdAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  description String?
  filterState Json     // Estrutura serializada dos filtros e colunas
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId, accountId])
}
